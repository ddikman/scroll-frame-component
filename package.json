{
  "name": "scroll-frame-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Animated scrolling screenshots in responsive device mockups",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "npm run check && npm run build:lib && npm run build:example",
    "build:lib": "vite build --mode library && tsc -p tsconfig.build.json",
    "build:example": "vite build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.1"
  }
}
